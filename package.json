{
  "name": "template-master-sidebar",
  "private": true,
  "version": "1.3.2",
  "type": "module",
  "homepage": "https://smartyoni.github.io/Nexus",
  "scripts": {
    "dev": "vite",
    "dev:pwa": "cross-env BUILD_TARGET=pwa vite",
    "dev:extension": "cross-env BUILD_TARGET=extension vite",
    "build": "npm run build:pwa && npm run build:extension",
    "build:pwa": "cross-env BUILD_TARGET=pwa vite build",
    "build:firebase": "cross-env BUILD_TARGET=pwa DEPLOY_TARGET=firebase vite build",
    "build:github": "cross-env BUILD_TARGET=pwa DEPLOY_TARGET=github vite build",
    "build:extension": "cross-env BUILD_TARGET=extension vite build",
    "preview": "vite preview",
    "preview:pwa": "cross-env BUILD_TARGET=pwa vite preview --outDir dist-pwa",
    "generate-icons": "node scripts/generate-icons.js",
    "deploy": "npm run build:firebase && firebase deploy",
    "deploy:github-pages": "npm run build:github && gh-pages -d dist-pwa",
    "deploy:all": "npm run build:extension && git push && npm run deploy && npm run deploy:github-pages"
  },
  "dependencies": {
    "@milkdown/core": "^7.20.0",
    "@milkdown/crepe": "^7.20.0",
    "@milkdown/kit": "^7.20.0",
    "@milkdown/plugin-block": "^7.20.0",
    "@milkdown/plugin-cursor": "^7.20.0",
    "@milkdown/plugin-history": "^7.20.0",
    "@milkdown/plugin-listener": "^7.20.0",
    "@milkdown/plugin-slash": "^7.20.0",
    "@milkdown/preset-commonmark": "^7.20.0",
    "@milkdown/preset-gfm": "^7.20.0",
    "@milkdown/prose": "^7.20.0",
    "@milkdown/react": "^7.20.0",
    "@milkdown/theme-nord": "^7.20.0",
    "@prosemirror-adapter/react": "^0.5.3",
    "firebase": "^12.6.0",
    "lucide-react": "^0.556.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.17",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.22",
    "cross-env": "^10.1.0",
    "gh-pages": "^6.3.0",
    "postcss": "^8.5.6",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.1.17",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vite-plugin-pwa": "^1.2.0",
    "workbox-window": "^7.4.0"
  }
}
